{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "BUILD_JSDOC",
			"type": "shell",
			"command": "jsdoc -c jsdoc.conf.json",
			"group": "build",
			"problemMatcher": []
		},
		{
			"label": "BUILD_LIBRARY_DEBUG",
			"type": "shell",
			"command": "esbuild import.js --bundle --outfile=build/vanilla.js --format=esm --keep-names --sourcemap",
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"problemMatcher": []
		},
		{
			"label": "BUILD_LIBRARY_RELEASE",
			"type": "shell",
			"command": "esbuild import.js --bundle --outfile=build/vanilla.min.js --format=esm --keep-names --minify",
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"problemMatcher": []
		},
		{
			"label": "BUILD_BUNDLE_DEBUG",
			"type": "shell",
			"command": "esbuild tutorial.js --bundle --outfile=build/bundle.js --format=iife --keep-names --sourcemap",
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"problemMatcher": []
		},
		{
			"label": "BUILD_BUNDLE_RELEASE",
			"type": "shell",
			"command": "esbuild tutorial.js --bundle --outfile=build/bundle.min.js --format=iife --minify",
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"problemMatcher": []
		}
	]
}